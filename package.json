{
  "name": "agentdock",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10 <11"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter agentdock run --parallel \"/^dev:(server|web)$/\"",
    "dev:server": "cargo run -p agentdock-server",
    "dev:web": "pnpm --dir apps/web dev",
    "build:web": "pnpm --dir apps/web build",
    "typecheck:web": "pnpm --dir apps/web typecheck",
    "test": "node --no-experimental-webstorage --import tsx --test --test-timeout=30000 \"apps/web/src/**/*.test.mjs\" \"packages/native-bridge/**/*.test.mjs\" \"npm/**/*.test.mjs\"",
    "check": "pnpm typecheck:web && pnpm test",
    "init": "cargo run -p agentdock-server -- init"
  },
  "devDependencies": {
    "tsx": "4.23.13"
  }
}
